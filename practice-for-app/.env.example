# SQLite paths are resolved relative to prisma/schema.prisma by Prisma CLI.
# Local database files are generated from migrations and are not committed.
DATABASE_URL="file:./app.db"

# Required in production. Generate at least 32 random bytes, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Optional: all three are required together when running npm run db:seed.
# SEED_EMAIL="demo@example.com"
# SEED_USERNAME="Demo User"
# SEED_PASSWORD="use-a-long-local-only-password"
