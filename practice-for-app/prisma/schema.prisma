generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  wordCards    WordCard[]
  studyLogs    StudyLog[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model WordCard {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   Int
  owner     Account  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("word_cards")
}

model StudyLog {
  id              Int      @id @default(autoincrement())
  clientSessionId String
  subject         String
  durationSeconds Int
  startedAt       DateTime
  endedAt         DateTime
  createdAt       DateTime @default(now())
  ownerId         Int
  owner           Account  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, clientSessionId])
  @@index([ownerId, startedAt])
}
